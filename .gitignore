# Python
__pycache__/
*.pyc

# Virtualenv
backend/.venv/
backend/.venv312/
.venv/
venv/
env/
# Database files
*.db
pofa_dev.db

# ML model weights (auto-downloaded at runtime, never committed)
*.pt
*.onnx
*.engine

# Alembic versions (committed migrations are okay; ignore local caches)
.alembic_tmp

# Editor
.vscode/
/.idea/

dist/
build/
*.egg-info/
*.log
.env
backend/.venv312*/

# Database dumps and backups: they hold real rows, so they never belong in Git.
*.dump

# Frontend dependency trees, including the generated manifests inside them.
node_modules/

# Local secret stores and probe state (each holds generated credentials).
**/secrets.env
Scratch/deploy1/armfull_state.json

# Every artifact class that Phase 1 found reachable in unpublished history:
# a 704 MB image export, a captured role password, a dumped test URL and a
# backup copy of the developer .env.
*.tar
*.tgz
*.zip
*_password.txt
*_password.lst
*credential*.txt
_testurl.txt
env.owner.backup
*.env.bak
*.env.backup
# Any real .env, while still allowing the documented templates.
**/.env
!**/.env.example
!**/.env.*.example

# Generated probe output; evidence belongs in the committed .out summaries.
Scratch/**/*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/

# A git worktree of another branch checked out inside this repo; the nested
# branch owns that history, so it must not be recorded as a gitlink here.
Scratch/mbe01-frontend/
