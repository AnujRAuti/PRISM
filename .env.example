# PostgreSQL connection using psycopg2 (development)
# DATABASE_URL is the RUNTIME identity used by the API and the background
# workers. In a production deployment point this at the least-privileged
# `poa_runtime` role (SELECT/INSERT only on the audit ledger, no DDL), NOT the
# database owner. The development default below uses the owner for local ease
# only.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pofa_dev

# BE-037: separate MIGRATION identity for schema changes. Alembic uses this when
# it is set and otherwise falls back to DATABASE_URL, so development (unset) is
# unchanged. In production set it to the owning `poa_migrator` role and run
# `alembic upgrade head` explicitly (e.g. the compose `migrate` service); never
# grant the runtime role migration privileges. Provide the value through your
# approved secret store, not a committed file.
# MIGRATION_DATABASE_URL=postgresql+psycopg2://poa_migrator@pofa-db:5432/pofa

# Application environment. Production must be set explicitly; the config
# validator then refuses an insecure JWT secret, non-enforcing auth_mode, enabled
# dev bearer tokens, and wildcard CORS (fail-closed before startup).
# ENVIRONMENT=production
REDIS_URL=redis://localhost:6379/0
ANALYSIS_QUEUE_NAME=pofa:analysis:jobs
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_ABANDONED_TIMEOUT_SECONDS=300

# Analysis worker resilience (BE-037 I1 + WS-C). Every value below is seconds
# and is the default implemented in backend/core/config.py; see
# docs/storage.md#redis-outages-and-tuning for the operator-facing walkthrough.
# These take effect for a worker started with `python -m
# backend.workers.analysis_worker`; the Compose stack's environment block
# forwards none of the ANALYSIS_* names, so a containerised worker stays on the
# compiled defaults until a variable is added there.
#
# Outage backoff. When a queue call fails the worker waits
#   min(ANALYSIS_RETRY_BACKOFF_MAX_SECONDS,
#       ANALYSIS_RETRY_BACKOFF_BASE_SECONDS * 2 ** (consecutive_failures - 1))
# and then sleeps half of that fixed plus a random draw of the other half, so a
# single outage's waits run roughly 1s, 2s, 4s ... and settle at a steady
# between-30-and-60s poll rate instead of growing without limit. The jitter is
# what keeps several workers that lost Redis at the same instant from all
# retrying together. The worker does not give up and exit during an outage: the
# queued jobs live in Redis, so leaving would strand them.
ANALYSIS_RETRY_BACKOFF_BASE_SECONDS=1.0
ANALYSIS_RETRY_BACKOFF_MAX_SECONDS=60.0
# Each backoff wait is slept in slices of this length so SIGTERM is noticed
# during the wait rather than after it: it bounds how long `docker stop` waits
# for a worker that is backing off. Lower stops faster at the cost of a few more
# wakeups. It does NOT bound stopping an idle worker: a blocked dequeue is one
# unsliceable read, so that case waits for the rest of
# ANALYSIS_DEQUEUE_BLOCK_SECONDS instead.
ANALYSIS_SHUTDOWN_POLL_SECONDS=0.5
# Socket bounds on the queue connection. SOCKET_TIMEOUT is the load-bearing one:
# it is the read deadline that converts a Redis which stops answering *without*
# closing the connection into a TimeoutError the worker can handle; without it
# the blocking dequeue hangs forever and never reaches the backoff or shutdown
# path. CONNECT bounds only establishing the TCP connection. HEALTH_CHECK reuses
# an idle connection check between commands - it helps a silently dead socket,
# never a read already in flight. DEQUEUE_BLOCK is how long an idle blocking
# dequeue waits for a message before returning nothing - and, because that read
# cannot be sliced, also how long stopping an IDLE worker takes (measured 18.62s
# at a 20s block, 1.5s at a 1s block), so keep it inside the stop grace period.
# Validation: SOCKET_TIMEOUT must be strictly greater than DEQUEUE_BLOCK or the
# queue raises ValueError at construction (the worker refuses to start) - an
# idle poll is *supposed* to end server-side with "no message", and a deadline
# at or below it reports every idle poll as an outage. No other range is
# enforced by the code, so keep these positive: a 0 backoff base removes the
# wait entirely and turns an outage into a tight poll loop.
ANALYSIS_REDIS_SOCKET_TIMEOUT_SECONDS=30.0
ANALYSIS_REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=10.0
ANALYSIS_REDIS_HEALTH_CHECK_INTERVAL_SECONDS=15.0
ANALYSIS_DEQUEUE_BLOCK_SECONDS=5

PHASH_MAX_HAMMING_DISTANCE=8
EMBEDDING_MODEL_NAME=openai/clip-vit-base-patch32
EMBEDDING_DIMENSION=512
EMBEDDING_TOP_K=10

# BE-009 Vision Intelligence (Ultralytics YOLO)
VISION_ENABLED=true
VISION_MODEL_NAME=yolo11n.pt
VISION_CONF_THRESHOLD=0.25
VISION_IOU_THRESHOLD=0.45
VISION_MAX_DETECTIONS=100
VISION_DEVICE=auto
VISION_IMGSZ=640

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false
S3_QUARANTINE_BUCKET=pofa-quarantine
S3_EVIDENCE_BUCKET=pofa-evidence
MAX_UPLOAD_SIZE=10485760

# MinIO container credentials (keep these aligned with S3_ACCESS_KEY/S3_SECRET_KEY locally)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

JWT_SECRET=changeme

# CORS. Comma-separated origins allowed to call the API with credentials.
# "*" accepts every origin and is only acceptable for local development:
# credentials are enabled, so a wildcard makes the backend echo back whatever
# Origin a caller sends. List the real frontend origins for any shared deploy.
CORS_ALLOW_ORIGINS=*

# BE-016 Authentication & Authorization.
# development (default): anonymous requests keep working as before, while any
# presented credentials are fully enforced. enforcing: anonymous requests are
# rejected with 401. Set enforcing for any shared/production deployment.
AUTH_MODE=development
# Development bearer tokens (non-secret identifiers). Disable alongside
# AUTH_MODE=enforcing when OIDC/OAuth2 integration lands.
AUTH_DEV_TOKENS_ENABLED=true

# Notes: Ensure PostGIS and pgvector extensions are available in the database.
