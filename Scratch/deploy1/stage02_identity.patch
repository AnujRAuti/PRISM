diff --git a/.env.example b/.env.example
index 7a3e2300..faafeaa3 100644
--- a/.env.example
+++ b/.env.example
@@ -112,7 +112,35 @@ CORS_ALLOW_ORIGINS=*
 # rejected with 401. Set enforcing for any shared/production deployment.
 AUTH_MODE=development
 # Development bearer tokens (non-secret identifiers). Disable alongside
-# AUTH_MODE=enforcing when OIDC/OAuth2 integration lands.
+# AUTH_MODE=enforcing: with AUTH_OIDC_ENABLED=true below, human callers have a
+# real credential and these tokens are the only thing being turned off.
 AUTH_DEV_TOKENS_ENABLED=true
 
+# Stage 02 human identity: verify the signed-in user's own access token locally
+# against the identity provider's published key set. Off by default, so an
+# existing deployment is unchanged until these are set. The browser sends the
+# user's token; it never sees an API-client secret.
+# The values below are public provider metadata, not secrets — the private
+# material stays with the provider. Set AUTH_OIDC_ISSUER and AUTH_OIDC_JWKS_URI
+# to exactly what the provider publishes (for Supabase: the project URL plus
+# /auth/v1, and its /.well-known/jwks.json), and keep AUTH_OIDC_AUDIENCE at the
+# provider's access-token audience ("authenticated" on Supabase).
+# AUTH_OIDC_ENABLED=true
+# AUTH_OIDC_ISSUER=https://<project-ref>.supabase.co/auth/v1
+# AUTH_OIDC_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
+# AUTH_OIDC_AUDIENCE=authenticated
+# Algorithms accepted from a token header. Comma-separated; only asymmetric
+# families are allowed — 'none' and any HMAC (HS*) algorithm is refused at
+# startup and at verification.
+# AUTH_OIDC_ALGORITHMS=RS256
+# The (identity_provider, external_subject) pair this service matches a token's
+# `sub` against in the users table. There is NO auto-provisioning: an
+# administrator creates and grants the account first, or the sign-in gets a 401
+# telling the user to ask for a role.
+# AUTH_OIDC_IDENTITY_PROVIDER=supabase
+# How long the fetched key set is reused, so the provider is not hit per request
+# (floor 30s). An unknown `kid` triggers at most one refetch per 30s, which is
+# how a key rotation is picked up without restarting.
+# AUTH_OIDC_JWKS_TTL_SECONDS=300
+
 # Notes: Ensure PostGIS and pgvector extensions are available in the database.
