@@ -0,0 +1,478 @@
+"""Stage 02-2: a reviewer signs in as themselves, and that is the identity used.
+
+Audit register rows 1.2/1.3 measured the opposite: the only credential an
+``enforcing`` deployment accepted was an API-client ``client_id:secret``, which a
+browser may never hold, so there was no way for a human reviewer to act on the
+API at all. These tests run the deployed posture end to end — ``auth_mode=
+enforcing``, ``auth_dev_tokens_enabled=false``, the identity provider enabled —
+and drive real routes with an access token signed by a key set the tests serve
+locally, so nothing here reaches the network.
+
+Two halves, both required. The identity half: a mapped reviewer completes a
+workflow action and the row records *their* id, while an unlinked subject, an
+expired token, a suspended account, a development token and no token at all are
+each refused before any handler runs. The authority half: a verified identity is
+not a permission — the same signed-in reviewer is denied an action their role
+lacks and denied another project's case, each paired with the same caller
+succeeding where they are granted, so a refusal can only come from the grant.
+
+Non-vacuity follows the same rule as the rest of stage 02: every refusal below
+is checked against rows and grants that genuinely exist, and every "nothing was
+written" claim compares real row counts.
+"""
+
+import json
+import time
+from uuid import uuid4
+
+import jwt
+import pytest
+from cryptography.hazmat.primitives.asymmetric import rsa
+from fastapi.testclient import TestClient
+from jwt.algorithms import RSAAlgorithm
+
+from backend.app.main import app
+from backend.core.config import settings
+from backend.db.models import (
+    Project,
+    ReviewCase,
+    ReviewCaseEvent,
+    User,
+    UserRoleAssignment,
+)
+from backend.db.session import get_session
+from backend.security import oidc
+from backend.services import authorization as auth_service
+
+
+client = TestClient(app)
+
+ISSUER = "https://poa-reviewer.supabase.co/auth/v1"
+JWKS_URI = ISSUER + "/.well-known/jwks.json"
+AUDIENCE = "authenticated"
+PROVIDER = "supabase"
+KID = "stage02-signing-key"
+
+#: The five settings a deployed backend would read from ``.env``.
+IDENTITY_SETTINGS = (
+    "auth_mode", "auth_dev_tokens_enabled", "auth_oidc_enabled",
+    "auth_oidc_issuer", "auth_oidc_jwks_uri", "auth_oidc_audience",
+    "auth_oidc_identity_provider", "auth_oidc_algorithms",
+    "auth_oidc_jwks_ttl_seconds",
+)
+
+
+@pytest.fixture(scope="module")
+def signing_key():
+    private_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+    jwk = json.loads(RSAAlgorithm.to_jwk(private_key.public_key()))
+    jwk["kid"] = KID
+    jwk["alg"] = "RS256"
+    return private_key, jwk
+
+
+@pytest.fixture(autouse=True)
+def production_identity(signing_key, monkeypatch):
+    """Enforcing, no development tokens, identity provider live on a local key set."""
+    private_key, jwk = signing_key
+    before = {name: getattr(settings, name) for name in IDENTITY_SETTINGS}
+    settings.auth_mode = "enforcing"
+    settings.auth_dev_tokens_enabled = False
+    settings.auth_oidc_enabled = True
+    settings.auth_oidc_issuer = ISSUER
+    settings.auth_oidc_jwks_uri = JWKS_URI
+    settings.auth_oidc_audience = AUDIENCE
+    settings.auth_oidc_identity_provider = PROVIDER
+    settings.auth_oidc_algorithms = "RS256"
+    settings.auth_oidc_jwks_ttl_seconds = 300
+    monkeypatch.setattr(oidc, "_fetch_key_set", lambda uri: {"keys": [jwk]})
+    oidc.reset_key_cache()
+    session = get_session()
+    try:
+        auth_service.ensure_default_catalogue(session)
+    finally:
+        session.close()
+    try:
+        yield private_key
+    finally:
+        for name, value in before.items():
+            setattr(settings, name, value)
+        oidc.reset_key_cache()
+
+
+def bearer(token: str) -> dict:
+    return {"Authorization": f"Bearer {token}"}
+
+
+def access_token(private_key, subject: str, **overrides) -> str:
+    now = int(time.time())
+    claims = {
+        "sub": subject, "iss": ISSUER, "aud": AUDIENCE,
+        "iat": now, "exp": now + 300,
+    }
+    claims.update(overrides)
+    return jwt.encode(claims, private_key, algorithm="RS256",
+                      headers={"kid": KID})
+
+
+def new_reviewer(auth_subject: str | None, *, label: str = "reviewer",
+                 status: str = "ACTIVE", provider: str = PROVIDER) -> str:
+    """A PoA account, the way an administrator provisions one: linked first."""
+    session = get_session()
+    try:
+        row = User(username=f"ident-{label}-{uuid4().hex[:8]}",
+                   email=f"{uuid4().hex[:8]}@stage02.test",
+                   external_subject=auth_subject, identity_provider=provider,
+                   status=status)
+        session.add(row)
+        session.commit()
+        return str(row.id)
+    finally:
+        session.close()
+
+
+def new_owner() -> str:
+    """An unlinked local account, only needed to satisfy projects.owner_id."""
+    return new_reviewer(None, label="owner", provider="local")
+
+
+def new_project(owner_id: str) -> str:
+    session = get_session()
+    try:
+        row = Project(name=f"ident {uuid4().hex[:6]}", owner_id=owner_id)
+        session.add(row)
+        session.commit()
+        return str(row.id)
+    finally:
+        session.close()
+
+
+def grant(user_id: str, role: str, scope_type: str = "GLOBAL",
+          project_id: str | None = None) -> None:
+    session = get_session()
+    try:
+        kwargs = {"project_id": project_id} if project_id else {}
+        auth_service.assign_role(session, user_id=user_id, role_name=role,
+                                 scope_type=scope_type, **kwargs)
+        session.commit()
+    finally:
+        session.close()
+
+
+def seed_case(project_id: str, status: str) -> str:
+    session = get_session()
+    try:
+        row = ReviewCase(project_id=project_id, origin="AUTHORIZED_USER",
+                         status=status)
+        session.add(row)
+        session.commit()
+        return str(row.id)
+    finally:
+        session.close()
+
+
+def case_row(case_id: str):
+    session = get_session()
+    try:
+        row = session.query(ReviewCase).filter(ReviewCase.id == case_id).one()
+        return row.status, row.decided_by
+    finally:
+        session.close()
+
+
+def case_actors(case_id: str, event_type: str) -> list[str | None]:
+    session = get_session()
+    try:
+        rows = session.query(ReviewCaseEvent).filter(
+            ReviewCaseEvent.case_id == case_id,
+            ReviewCaseEvent.event_type == event_type).all()
+        return [row.actor_id for row in rows]
+    finally:
+        session.close()
+
+
+def cleanup(*, users=(), projects=(), cases=()) -> None:
+    """FK-safe order: events, then cases, then grants/projects, then users."""
+    session = get_session()
+    try:
+        if cases:
+            session.query(ReviewCaseEvent).filter(
+                ReviewCaseEvent.case_id.in_(cases)).delete(
+                    synchronize_session=False)
+            session.query(ReviewCase).filter(
+                ReviewCase.id.in_(cases)).delete(synchronize_session=False)
+        if users:
+            session.query(UserRoleAssignment).filter(
+                UserRoleAssignment.user_id.in_(users)).delete(
+                    synchronize_session=False)
+        if projects:
+            session.query(Project).filter(
+                Project.id.in_(projects)).delete(synchronize_session=False)
+        if users:
+            session.query(User).filter(User.id.in_(users)).delete(
+                synchronize_session=False)
+        session.commit()
+    finally:
+        session.close()
+
+
+DECISION_BODY = {"decision": "INCONCLUSIVE", "rationale": "needs a field visit"}
+
+
+def decision_url(case_id: str) -> str:
+    return f"/api/v1/review-cases/{case_id}/decision"
+
+
+def read_url(case_id: str) -> str:
+    return f"/api/v1/review-cases/{case_id}"
+
+
+# ---------------------------------------------------------------------------
+# the identity half: a reviewer's own token is enough, and is the recorded actor
+# ---------------------------------------------------------------------------
+
+
+def test_a_signed_in_reviewer_is_attributed_to_themselves(production_identity):
+    private_key = production_identity
+    owner = new_owner()
+    subject = str(uuid4())
+    reviewer = new_reviewer(subject)
+    project_id = new_project(owner)
+    case_id = seed_case(project_id, "INVESTIGATING")
+    try:
+        grant(reviewer, "SUPERVISOR", "PROJECT", project_id)
+        # Non-vacuity: the case is decidable and the caller is granted, so the
+        # 200 below can only come from the identity path working.
+        assert case_row(case_id) == ("INVESTIGATING", None)
+
+        response = client.post(decision_url(case_id), json=DECISION_BODY,
+                               headers=bearer(access_token(private_key, subject)))
+        assert response.status_code == 200, response.text
+        assert case_row(case_id) == ("DECISION_PENDING", reviewer)
+        assert case_actors(case_id, "DECISION_RECORDED") == [reviewer]
+    finally:
+        cleanup(users=[owner, reviewer], projects=[project_id], cases=[case_id])
+
+
+def test_the_verified_identity_beats_a_forged_actor_field(production_identity):
+    private_key = production_identity
+    owner = new_owner()
+    subject = str(uuid4())
+    reviewer = new_reviewer(subject)
+    colleague = new_reviewer(str(uuid4()), label="colleague")
+    project_id = new_project(owner)
+    case_id = seed_case(project_id, "INVESTIGATING")
+    try:
+        grant(reviewer, "SUPERVISOR", "PROJECT", project_id)
+        headers = bearer(access_token(private_key, subject))
+
+        forged = client.post(decision_url(case_id),
+                             json={**DECISION_BODY, "decided_by": colleague},
+                             headers=headers)
+        assert forged.status_code == 403, forged.text
+        assert "decided_by" in forged.json()["detail"]
+        assert case_row(case_id) == ("INVESTIGATING", None)
+        assert case_actors(case_id, "DECISION_RECORDED") == []
+
+        allowed = client.post(decision_url(case_id), json=DECISION_BODY,
+                              headers=headers)
+        assert allowed.status_code == 200, allowed.text
+        assert case_row(case_id) == ("DECISION_PENDING", reviewer)
+    finally:
+        cleanup(users=[owner, reviewer, colleague], projects=[project_id],
+                cases=[case_id])
+
+
+def test_no_credential_at_all_is_still_refused(production_identity):
+    owner = new_owner()
+    project_id = new_project(owner)
+    case_id = seed_case(project_id, "INVESTIGATING")
+    try:
+        assert case_row(case_id)[0] == "INVESTIGATING"
+        assert client.get(read_url(case_id)).status_code == 401
+        assert client.post(decision_url(case_id), json=DECISION_BODY).status_code == 401
+    finally:
+        cleanup(users=[owner], projects=[project_id], cases=[case_id])
+
+
+def test_development_tokens_stay_refused_while_the_provider_is_enabled(
+        production_identity):
+    """The identity path must not quietly reopen the development door."""
+    private_key = production_identity
+    owner = new_owner()
+    subject = str(uuid4())
+    reviewer = new_reviewer(subject)
+    project_id = new_project(owner)
+    case_id = seed_case(project_id, "INVESTIGATING")
+    try:
+        grant(reviewer, "SUPERVISOR", "PROJECT", project_id)
+        dev = bearer(f"dev-user-{reviewer}")
+        assert client.get(read_url(case_id), headers=dev).status_code == 401
+        assert client.post(decision_url(case_id), json=DECISION_BODY,
+                           headers=dev).status_code == 401
+        # The very same account is accepted when it presents its own token.
+        assert client.get(read_url(case_id), headers=bearer(
+            access_token(private_key, subject))).status_code == 200
+    finally:
+        cleanup(users=[owner, reviewer], projects=[project_id], cases=[case_id])
+
+
+# ---------------------------------------------------------------------------
+# the identity half, refusals: each is the layer that stops it, not the row
+# ---------------------------------------------------------------------------
+
+
+def test_a_valid_token_with_no_linked_account_is_refused_without_writing(
+        production_identity):
+    private_key = production_identity
+    owner = new_owner()
+    project_id = new_project(owner)
+    case_id = seed_case(project_id, "INVESTIGATING")
+    try:
+        response = client.post(decision_url(case_id), json=DECISION_BODY,
+                               headers=bearer(access_token(private_key, str(uuid4()))))
+        assert response.status_code == 401, response.text
+        assert "No account is linked" in response.json()["detail"]
+        assert case_row(case_id) == ("INVESTIGATING", None)
+        assert case_actors(case_id, "DECISION_RECORDED") == []
+    finally:
+        cleanup(users=[owner], projects=[project_id], cases=[case_id])
+
+
+def test_an_expired_token_for_a_mapped_reviewer_is_refused(production_identity):
+    """The account exists and is granted; only the token has run out."""
+    private_key = production_identity
+    owner = new_owner()
+    subject = str(uuid4())
+    reviewer = new_reviewer(subject)
+    project_id = new_project(owner)
+    case_id = seed_case(project_id, "INVESTIGATING")
+    now = int(time.time())
+    try:
+        grant(reviewer, "SUPERVISOR", "PROJECT", project_id)
+        assert client.get(read_url(case_id), headers=bearer(
+            access_token(private_key, subject))).status_code == 200
+
+        expired = client.get(read_url(case_id), headers=bearer(access_token(
+            private_key, subject, iat=now - 7200, exp=now - 3600)))
+        assert expired.status_code == 401, expired.text
+        assert "No account is linked" not in expired.json()["detail"]
+    finally:
+        cleanup(users=[owner, reviewer], projects=[project_id], cases=[case_id])
+
+
+def test_a_suspended_reviewers_token_is_refused(production_identity):
+    private_key = production_identity
+    owner = new_owner()
+    subject = str(uuid4())
+    reviewer = new_reviewer(subject, status="SUSPENDED")
+    project_id = new_project(owner)
+    case_id = seed_case(project_id, "INVESTIGATING")
+    try:
+        grant(reviewer, "SUPERVISOR", "PROJECT", project_id)
+        response = client.post(decision_url(case_id), json=DECISION_BODY,
+                               headers=bearer(access_token(private_key, subject)))
+        assert response.status_code == 401, response.text
+        assert response.json()["detail"] == "Invalid credentials"
+        assert case_row(case_id) == ("INVESTIGATING", None)
+    finally:
+        cleanup(users=[owner, reviewer], projects=[project_id], cases=[case_id])
+
+
+def test_a_token_signed_for_another_audience_is_refused(production_identity):
+    private_key = production_identity
+    owner = new_owner()
+    subject = str(uuid4())
+    reviewer = new_reviewer(subject)
+    project_id = new_project(owner)
+    case_id = seed_case(project_id, "INVESTIGATING")
+    try:
+        grant(reviewer, "SUPERVISOR", "PROJECT", project_id)
+        response = client.get(read_url(case_id), headers=bearer(access_token(
+            private_key, subject, aud="service-role")))
+        assert response.status_code == 401, response.text
+    finally:
+        cleanup(users=[owner, reviewer], projects=[project_id], cases=[case_id])
+
+
+def test_a_refresh_token_is_not_accepted_as_a_signed_in_session(
+        production_identity):
+    private_key = production_identity
+    owner = new_owner()
+    subject = str(uuid4())
+    reviewer = new_reviewer(subject)
+    project_id = new_project(owner)
+    case_id = seed_case(project_id, "INVESTIGATING")
+    try:
+        grant(reviewer, "SUPERVISOR", "PROJECT", project_id)
+        response = client.get(read_url(case_id), headers=bearer(access_token(
+            private_key, subject, use="refresh")))
+        assert response.status_code == 401, response.text
+    finally:
+        cleanup(users=[owner, reviewer], projects=[project_id], cases=[case_id])
+
+
+def test_a_link_is_per_provider_so_the_same_subject_cannot_cross_over(
+        production_identity):
+    """users(external_subject) is only unique together with its provider."""
+    private_key = production_identity
+    owner = new_owner()
+    subject = str(uuid4())
+    reviewer = new_reviewer(subject, label="supabase-side")
+    other = new_reviewer(subject, label="other-side", provider="another-provider")
+    project_id = new_project(owner)
+    case_id = seed_case(project_id, "INVESTIGATING")
+    try:
+        grant(reviewer, "SUPERVISOR", "PROJECT", project_id)
+        # Granted as `reviewer`, so this resolves to reviewer's id, never other's.
+        response = client.post(decision_url(case_id), json=DECISION_BODY,
+                               headers=bearer(access_token(private_key, subject)))
+        assert response.status_code == 200, response.text
+        assert case_row(case_id) == ("DECISION_PENDING", reviewer)
+        assert case_row(case_id)[1] != other
+    finally:
+        cleanup(users=[owner, reviewer, other], projects=[project_id],
+                cases=[case_id])
+
+
+# ---------------------------------------------------------------------------
+# the authority half: a verified identity is not a permission
+# ---------------------------------------------------------------------------
+
+
+def test_a_signed_in_reviewer_still_lacks_ungranted_actions(production_identity):
+    """REVIEWER may read and investigate a case, never decide it."""
+    private_key = production_identity
+    owner = new_owner()
+    subject = str(uuid4())
+    reviewer = new_reviewer(subject)
+    project_id = new_project(owner)
+    case_id = seed_case(project_id, "INVESTIGATING")
+    try:
+        grant(reviewer, "REVIEWER", "PROJECT", project_id)
+        headers = bearer(access_token(private_key, subject))
+        assert client.get(read_url(case_id), headers=headers).status_code == 200
+        denied = client.post(decision_url(case_id), json=DECISION_BODY, headers=headers)
+        assert denied.status_code == 403, denied.text
+        assert case_row(case_id) == ("INVESTIGATING", None)
+    finally:
+        cleanup(users=[owner, reviewer], projects=[project_id], cases=[case_id])
+
+
+def test_a_signed_in_reviewer_cannot_reach_a_foreign_project(production_identity):
+    private_key = production_identity
+    owner = new_owner()
+    subject = str(uuid4())
+    reviewer = new_reviewer(subject)
+    mine, theirs = new_project(owner), new_project(owner)
+    their_case = seed_case(theirs, "INVESTIGATING")
+    my_case = seed_case(mine, "INVESTIGATING")
+    try:
+        grant(reviewer, "SUPERVISOR", "PROJECT", mine)
+        headers = bearer(access_token(private_key, subject))
+        assert client.get(read_url(their_case), headers=headers).status_code in (403, 404)
+        # Same caller, same route, only the project differs.
+        assert client.get(read_url(my_case), headers=headers).status_code == 200
+    finally:
+        cleanup(users=[owner, reviewer], projects=[mine, theirs],
+                cases=[their_case, my_case])
diff --git a/tests/unit/test_actor_attribution.py b/tests/unit/test_actor_attribution.py
new file mode 100644
index 00000000..4a154cbf
--- /dev/null
+++ b/tests/unit/test_actor_attribution.py
@@ -0,0 +1,74 @@
+"""Unit tests for the single actor-attribution policy point (Stage 02-3).
+
+The HTTP surface is covered by ``tests/integration/test_stage02_actor_attribution.py``;
+what lives here are the branches that endpoint guards make unreachable in one
+mode or another — the development-bypass exception and the refusal to credit an
+unauthenticated caller — so the docstring in ``backend/security/attribution.py``
+stays a measured claim instead of a promise.
+"""
+
+from uuid import uuid4
+
+import pytest
+from fastapi import HTTPException
+
+from backend.core.config import settings
+from backend.security.attribution import derive_actor
+from backend.services.authorization import Principal
+
+
+def user_principal(user_id: str) -> Principal:
+    return Principal(principal_id=user_id, principal_type="USER",
+                     authenticated=True, status="ACTIVE")
+
+
+def anonymous_principal() -> Principal:
+    return Principal(principal_id=None, principal_type="ANONYMOUS",
+                     authenticated=False, status="ANONYMOUS")
+
+
+@pytest.fixture
+def enforcing(monkeypatch):
+    monkeypatch.setattr(settings, "auth_mode", "enforcing")
+
+
+@pytest.fixture
+def development(monkeypatch):
+    monkeypatch.setattr(settings, "auth_mode", "development")
+
+
+def test_missing_actor_field_is_filled_from_the_credential(enforcing):
+    assert derive_actor(user_principal("principal-1")) == "principal-1"
+    assert derive_actor(user_principal("principal-1"), None, field="decided_by") == "principal-1"
+
+
+def test_restatement_of_the_callers_own_id_is_accepted(enforcing):
+    assert derive_actor(user_principal("principal-1"), "principal-1") == "principal-1"
+
+
+def test_naming_someone_else_is_refused_before_any_write(enforcing):
+    victim = str(uuid4())
+    with pytest.raises(HTTPException) as refusal:
+        derive_actor(user_principal("principal-1"), victim, field="decided_by")
+    assert refusal.value.status_code == 403
+    assert "decided_by" in refusal.value.detail
+
+
+def test_a_uuid_value_matches_the_string_principal_id(enforcing):
+    from uuid import UUID
+
+    principal_id = str(uuid4())
+    assert derive_actor(user_principal(principal_id), UUID(principal_id)) == principal_id
+
+
+def test_an_unauthenticated_caller_may_not_be_recorded_as_an_actor(enforcing):
+    with pytest.raises(HTTPException) as refusal:
+        derive_actor(anonymous_principal(), str(uuid4()))
+    assert refusal.value.status_code == 401
+
+
+def test_development_mode_is_the_documented_exception(development):
+    """AUTH_MODE=development has no verified identity to derive from."""
+    supplied = str(uuid4())
+    assert derive_actor(anonymous_principal(), supplied) == supplied
+    assert derive_actor(anonymous_principal()) is None
diff --git a/tests/unit/test_stage02_oidc_verification.py b/tests/unit/test_stage02_oidc_verification.py
new file mode 100644
index 00000000..4b603eed
--- /dev/null
+++ b/tests/unit/test_stage02_oidc_verification.py
@@ -0,0 +1,326 @@
+"""Stage 02-2: a reviewer's own token is verified here, and only these ways.
+
+Audit register rows 1.2/1.3 measured that no human identity path existed: the
+only credential an ``enforcing`` deployment accepted was a service
+``client_id:secret``, which a browser may never hold. This module pins the
+verifier that replaces it — signature, algorithm, issuer, audience, lifetime,
+key rotation and refusal hygiene — with a locally generated key set, so not one
+test touches the network.
+
+The refusals are the point. Each one is checked against a token that *would* be
+accepted by a naive decoder: an unsigned ``alg: none`` token, an HMAC token
+signed with the provider's own public material, an expired token, a token for a
+different audience or issuer, and a token naming a key the provider never
+published. A verifier that only ever says yes to the happy path proves nothing.
+"""
+
+import base64
+import hashlib
+import hmac
+import json
+import logging
+import time
+from uuid import uuid4
+
+import jwt
+import pytest
+from cryptography.hazmat.primitives import serialization
+from cryptography.hazmat.primitives.asymmetric import rsa
+from jwt.algorithms import RSAAlgorithm
+
+from backend.core.config import Settings
+from backend.security import oidc
+
+
+ISSUER = "https://poa-test.supabase.co/auth/v1"
+AUDIENCE = "authenticated"
+KID = "key-abc"
+
+
+@pytest.fixture(scope="module")
+def keypair():
+    private_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+    public_jwk = json.loads(RSAAlgorithm.to_jwk(private_key.public_key()))
+    public_jwk["kid"] = KID
+    public_jwk["alg"] = "RS256"
+    return private_key, public_jwk
+
+
+@pytest.fixture
+def rotation_keypair():
+    private_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+    public_jwk = json.loads(RSAAlgorithm.to_jwk(private_key.public_key()))
+    public_jwk["kid"] = "key-rot"
+    public_jwk["alg"] = "RS256"
+    return private_key, public_jwk
+
+
+@pytest.fixture(autouse=True)
+def configured(keypair, monkeypatch):
+    """OIDC switched on against a local key set; no outbound request ever happens."""
+    private_key, public_jwk = keypair
+    settings = {
+        "auth_oidc_enabled": True,
+        "auth_oidc_issuer": ISSUER,
+        "auth_oidc_jwks_uri": "https://poa-test.supabase.co/auth/v1/.well-known/jwks.json",
+        "auth_oidc_audience": AUDIENCE,
+        "auth_oidc_identity_provider": "supabase",
+        "auth_oidc_algorithms": "RS256",
+        "auth_oidc_jwks_ttl_seconds": 300,
+    }
+    for name, value in settings.items():
+        monkeypatch.setattr(oidc.settings, name, value)
+    oidc.reset_key_cache()
+    calls = []
+
+    def fake_fetch(uri):
+        calls.append(uri)
+        return {"keys": [public_jwk]}
+
+    monkeypatch.setattr(oidc, "_fetch_key_set", fake_fetch)
+    yield {"private_key": private_key, "jwk": public_jwk, "calls": calls}
+    oidc.reset_key_cache()
+
+
+def _b64(data: bytes) -> bytes:
+    return base64.urlsafe_b64encode(data).rstrip(b"=")
+
+
+def token(private_key, **overrides):
+    now = int(time.time())
+    claims = {
+        "sub": str(uuid4()),
+        "iss": ISSUER,
+        "aud": AUDIENCE,
+        "iat": now,
+        "exp": now + 300,
+        "email": "reviewer@example.test",
+    }
+    claims.update(overrides)
+    return jwt.encode(claims, private_key, algorithm="RS256", headers={"kid": KID})
+
+
+# ---------------------------------------------------------------------------
+# the happy path, and the caching it must not break
+# ---------------------------------------------------------------------------
+
+
+def test_a_validly_signed_token_yields_its_claims(configured):
+    claims = oidc.verify_token(token(configured["private_key"], sub="reviewer-1"))
+    assert claims["sub"] == "reviewer-1"
+    assert claims["aud"] == AUDIENCE
+
+
+def test_the_key_set_is_fetched_once_not_per_request(configured):
+    signed = token(configured["private_key"])
+    for _ in range(5):
+        oidc.verify_token(signed)
+    assert configured["calls"] == [oidc.settings.auth_oidc_jwks_uri]
+
+
+def test_no_token_material_reaches_the_log(configured, caplog):
+    signed = token(configured["private_key"])
+    with caplog.at_level(logging.WARNING):
+        for bad in (signed + "x", "not.a.jwt", "a.b.c"):
+            with pytest.raises(oidc.OIDCError):
+                oidc.verify_token(bad)
+    assert signed not in caplog.text
+    assert "reviewer@example.test" not in caplog.text
+
+
+# ---------------------------------------------------------------------------
+# every refusal a naive decoder would have accepted
+# ---------------------------------------------------------------------------
+
+
+def test_a_tampered_signature_is_refused(configured):
+    signed = token(configured["private_key"])
+    header, payload, signature = signed.split(".")
+    forged = ".".join([header, payload, "A" * len(signature)])
+    with pytest.raises(oidc.OIDCError) as error:
+        oidc.verify_token(forged)
+    assert error.value.reason == "TOKEN_REJECTED"
+
+
+def test_an_unsigned_alg_none_token_is_refused(configured):
+    now = int(time.time())
+    unsigned = jwt.encode(
+        {"sub": "attacker", "iss": ISSUER, "aud": AUDIENCE, "iat": now, "exp": now + 300},
+        key=None, algorithm="none")
+    with pytest.raises(oidc.OIDCError) as error:
+        oidc.verify_token(unsigned)
+    assert error.value.reason == "ALGORITHM_REFUSED"
+
+
+def test_a_token_forged_with_the_public_key_as_an_hmac_secret_is_refused(configured):
+    """The classic confusion: sign HS256 using the published RSA material.
+
+    PyJWT's own encoder refuses PEM material as an HMAC secret, so the attack
+    token is assembled by hand — a real attacker is not bound by that
+    convenience, and the verifier must still refuse what it receives.
+    """
+    now = int(time.time())
+    public_pem = configured["private_key"].public_key().public_bytes(
+        encoding=serialization.Encoding.PEM,
+        format=serialization.PublicFormat.SubjectPublicKeyInfo)
+    header = _b64(json.dumps({"alg": "HS256", "typ": "JWT", "kid": KID}).encode())
+    payload = _b64(json.dumps({
+        "sub": "attacker", "iss": ISSUER, "aud": AUDIENCE, "iat": now, "exp": now + 300,
+    }).encode())
+    signing_input = header + b"." + payload
+    signature = _b64(hmac.new(public_pem, signing_input, hashlib.sha256).digest())
+    forged = (signing_input + b"." + signature).decode()
+    with pytest.raises(oidc.OIDCError) as error:
+        oidc.verify_token(forged)
+    assert error.value.reason == "ALGORITHM_REFUSED"
+
+
+def test_a_token_signed_by_an_unpublished_key_is_refused(configured, rotation_keypair):
+    other_private, _ = rotation_keypair
+    with pytest.raises(oidc.OIDCError) as error:
+        oidc.verify_token(jwt.encode(
+            {"sub": "x", "iss": ISSUER, "aud": AUDIENCE,
+             "iat": int(time.time()), "exp": int(time.time()) + 300},
+            other_private, algorithm="RS256", headers={"kid": "not-published"}))
+    assert error.value.reason == "UNKNOWN_KEY_ID"
+    # An unknown kid costs exactly one refetch, so a flood of bad tokens cannot
+    # become a flood of outbound requests.
+    assert len(configured["calls"]) == 2
+
+
+def test_an_expired_token_is_refused(configured):
+    now = int(time.time())
+    with pytest.raises(oidc.OIDCError) as error:
+        oidc.verify_token(token(configured["private_key"], iat=now - 7200, exp=now - 3600))
+    assert error.value.reason == "TOKEN_REJECTED"
+
+
+def test_a_token_from_another_audience_is_refused(configured):
+    with pytest.raises(oidc.OIDCError) as error:
+        oidc.verify_token(token(configured["private_key"], aud="service-role"))
+    assert error.value.reason == "TOKEN_REJECTED"
+
+
+def test_a_token_from_another_issuer_is_refused(configured):
+    with pytest.raises(oidc.OIDCError) as error:
+        oidc.verify_token(token(configured["private_key"], iss="https://evil.example/auth"))
+    assert error.value.reason == "TOKEN_REJECTED"
+
+
+def test_a_refresh_token_is_refused(configured):
+    with pytest.raises(oidc.OIDCError) as error:
+        oidc.verify_token(token(configured["private_key"], use="refresh"))
+    assert error.value.reason == "REFRESH_TOKEN"
+
+
+def test_a_malformed_authorization_value_is_refused_without_a_fetch(configured):
+    with pytest.raises(oidc.OIDCError) as error:
+        oidc.verify_token("dev-user-11111111-1111-1111-1111-111111111111")
+    assert error.value.reason == "MALFORMED_TOKEN"
+    assert configured["calls"] == []
+
+
+def test_a_symmetric_entry_in_the_key_set_is_never_used_as_a_verification_key(
+        configured, monkeypatch):
+    planted = {"kty": "oct", "kid": "key-oct", "alg": "HS256",
+               "k": "c2VjcmV0LW1hdGVyaWFsLXBsYWNlaG9sZGVy"}
+
+    def with_planted(uri):
+        configured["calls"].append(uri)
+        return {"keys": [configured["jwk"], planted]}
+
+    monkeypatch.setattr(oidc, "_fetch_key_set", with_planted)
+    oidc.reset_key_cache()
+    assert "key-oct" not in oidc.signing_keys()
+
+
+# ---------------------------------------------------------------------------
+# key rotation and provider availability
+# ---------------------------------------------------------------------------
+
+
+def test_a_rotated_key_is_picked_up_on_the_first_unknown_kid(
+        configured, rotation_keypair, monkeypatch):
+    other_private, other_jwk = rotation_keypair
+    stages = [{"keys": [configured["jwk"]]},
+              {"keys": [configured["jwk"], other_jwk]}]
+
+    def rotating_fetch(uri):
+        configured["calls"].append(uri)
+        return stages[min(len(configured["calls"]) - 1, len(stages) - 1)]
+
+    monkeypatch.setattr(oidc, "_fetch_key_set", rotating_fetch)
+    oidc.reset_key_cache()
+    now = int(time.time())
+    claims = oidc.verify_token(jwt.encode(
+        {"sub": "rotated", "iss": ISSUER, "aud": AUDIENCE, "iat": now, "exp": now + 300},
+        other_private, algorithm="RS256", headers={"kid": "key-rot"}))
+    assert claims["sub"] == "rotated"
+    assert len(configured["calls"]) == 2
+
+
+def test_an_unreachable_provider_fails_closed(configured, monkeypatch):
+    import httpx
+
+    def down(uri):
+        configured["calls"].append(uri)
+        raise httpx.ConnectError("provider down")
+
+    oidc.reset_key_cache()
+    monkeypatch.setattr(oidc, "_fetch_key_set", down)
+    with pytest.raises(oidc.OIDCError) as error:
+        oidc.verify_token(token(configured["private_key"]))
+    assert error.value.reason == "KEY_SET_UNAVAILABLE"
+
+
+def test_a_still_fresh_key_set_carries_a_request_through_a_provider_hiccup(
+        configured, monkeypatch):
+    import httpx
+
+    oidc.verify_token(token(configured["private_key"]))  # fills the cache
+
+    def down(uri):
+        raise httpx.ConnectError("provider down")
+
+    monkeypatch.setattr(oidc, "_fetch_key_set", down)
+    claims = oidc.verify_token(token(configured["private_key"]))
+    assert claims["aud"] == AUDIENCE
+
+
+# ---------------------------------------------------------------------------
+# configuration: a half-configured verifier must refuse to start
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("overrides", [
+    {"auth_oidc_issuer": ""},
+    {"auth_oidc_jwks_uri": ""},
+    {"auth_oidc_issuer": "http://insecure.example/auth"},
+    {"auth_oidc_jwks_uri": "http://insecure.example/jwks.json"},
+    {"auth_oidc_audience": "  "},
+    {"auth_oidc_algorithms": "none"},
+    {"auth_oidc_algorithms": "HS256"},
+    {"auth_oidc_algorithms": "RS256,HS256"},
+    {"auth_oidc_algorithms": ""},
+])
+def test_enabling_oidc_without_usable_settings_is_refused_at_startup(overrides):
+    base = dict(auth_oidc_enabled=True, auth_oidc_issuer=ISSUER,
+                auth_oidc_jwks_uri="https://poa-test.supabase.co/auth/v1/.well-known/jwks.json",
+                auth_oidc_audience=AUDIENCE, auth_oidc_algorithms="RS256")
+    base.update(overrides)
+    with pytest.raises(ValueError):
+        Settings(**base)
+
+
+def test_oidc_stays_opt_in_and_unconfigured_settings_are_accepted():
+    """An integration-only deployment must keep starting with no OIDC config."""
+    quiet = Settings(auth_oidc_enabled=False, auth_oidc_issuer="", auth_oidc_jwks_uri="",
+                     auth_oidc_algorithms="none")
+    assert quiet.auth_oidc_enabled is False
+
+
+def test_asymmetric_families_are_all_acceptable_configuration():
+    configured = Settings(auth_oidc_enabled=True, auth_oidc_issuer=ISSUER,
+                          auth_oidc_jwks_uri="https://poa-test.supabase.co/jwks.json",
+                          auth_oidc_algorithms="RS256, ES256, PS256")
+    assert configured.auth_oidc_algorithms == "RS256, ES256, PS256"
