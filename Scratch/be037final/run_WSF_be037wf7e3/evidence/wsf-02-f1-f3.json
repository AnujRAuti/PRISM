  "observation_wsf_obs_1": {
    "title": "Client-driven ingest requires a GLOBAL grant for the context step",
    "measured": [
      {
        "phase": "dev_tokens_off",
        "case": "project-scoped client attaches context to evidence it uploaded",
        "expected": 404,
        "observed": 404
      },
      {
        "phase": "dev_tokens_off",
        "case": "client without evidence.update_context attaches context",
        "expected": 403,
        "observed": 403
      },
      {
        "phase": "dev_tokens_off",
        "case": "GLOBAL-scope intake client attaches evidence to project A",
        "expected": 200,
        "observed": 200
      },
      {
        "phase": "dev_tokens_on",
        "case": "ORG-scope FIELD_OFFICER attaches context to unprojected evidence",
        "expected": 404,
        "observed": 404
      },
      {
        "phase": "dev_tokens_on",
        "case": "GLOBAL ADMINISTRATOR attaches evidence to project A",
        "expected": 403,
        "observed": 403
      },
      {
        "phase": "dev_tokens_on",
        "case": "GLOBAL FIELD_OFFICER (intake) attaches evidence to project A",
        "expected": 200,
        "observed": 200
      }
    ],
    "mechanism": "resolve_resource_scope() reports no project for an unprojected evidence (backend/services/authorization.py:1003), can() answers RESOURCE_UNSCOPEABLE, and enforce() maps that to 404 (backend/security/authorization.py:163). The rule is unit-pinned by tests/unit/test_authorization.py::test_unscoped_resource_requires_global, so fail-closed here is intended behaviour, not a regression.",
    "consequence": "an integrator holding only project- or organization-scoped permissions can upload bytes but can never attach them to its own project, so every real ingestion needs a paired GLOBAL intake credential. POST /api/v1/evidence accepts no project or claim field, so there is no single-call alternative. No existing test covers this path: every context-attach test runs under the development bypass.",
    "classification": "Observation / design gap for the owner, not a security defect"
  },
