# Browser-visible API URL. Leave unset to use the Vite development proxy.
# In a deployment, set this to the API origin plus /api/v1.
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_PROXY_TARGET=http://localhost:8000

# Supabase Auth is an optional OIDC identity provider for the FastAPI backend.
# The matching user must already be provisioned in the backend and linked by
# AUTH_OIDC_IDENTITY_PROVIDER + external_subject. These are public client values,
# never service-role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CARTO_API_KEY=cb1_52ac_1_23a45a3df023cdfec7891751
