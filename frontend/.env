# Environment Variables for Proof-of-Action Frontend

# API Configuration
VITE_API_BASE_URL=/api/v1

# Application Settings
VITE_APP_NAME=Proof-of-Action
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=true

# Sign-in provider (Supabase reviewer-auth project)
# The project URL is public; the publishable key is NOT stored here.
# Put the publishable key in .env.local (gitignored), never in this file.
VITE_SUPABASE_URL=https://tuaeujvuuanadqvykugw.supabase.co
